{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "aws-lambda-shutdown configuration",
  "type": "object",
  "required": ["general", "services"],
  "properties": {
    "general": {
      "type": "object",
      "required": ["schedule", "notification"],
      "properties": {
        "schedule": { "$ref": "#/definitions/schedule" },
        "notification": {
          "type": "object",
          "required": ["email"],
          "properties": {
            "email": { "type": "string", "format": "email" }
          }
        }
      }
    },
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "enabled": { "type": "boolean", "default": true },
          "schedule": { "$ref": "#/definitions/schedule" }
        }
      }
    }
  },
  "definitions": {
    "schedule": {
      "type": "object",
      "required": ["daysOfWeek", "times"],
      "properties": {
        "daysOfWeek": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["MON", "TUE", "WED", "THU", "FRI", "SAT", "SUN"] }
        },
        "times": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" }
        }
      }
    }
  }
}